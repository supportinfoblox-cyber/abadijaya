# ==============================================================================
# TicketOps Environment Variables Configuration Example
# Salin file ini menjadi .env.local untuk environment lokal.
# JANGAN PERNAH commit file .env atau .env.local yang berisi secret sungguhan!
# ==============================================================================

# Supabase Cloud Project Configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# iCare OTRS Agent Service Account (digunakan oleh OTRS bridge server-side)
OTRS_AGENT_USER=
OTRS_AGENT_PASSWORD=

# Server Configuration
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
NODE_ENV=production
